APP_NAME="Talisha Software"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://talishasoftware.tech

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Hostinger MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=talisha_website
DB_USERNAME=talisha_user
DB_PASSWORD=YOUR_SECURE_HOSTINGER_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

# Hostinger Business SMTP Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@talishasoftware.tech
MAIL_PASSWORD=YOUR_HOSTINGER_EMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@talishasoftware.tech"
MAIL_FROM_NAME="Talisha Software"
